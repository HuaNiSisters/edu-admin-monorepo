generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  M
  F
}

enum StudentStatus {
  active
  inactive
}

enum Location {
  cabramatta_and_canley_vale
  parramatta
  online
}

enum AttendanceStatus {
  present
  absent
}

enum EnrolmentStatus {
  active
  pending
  completed
  cancelled
  unenrolled
}

enum PaymentType {
  cash
  bank_transfer
  other
}

enum PaymentStatus {
  unpaid
  partial
  paid
}

enum SmsReminderType {
  upcoming_payment
  overdue_no_class_entry
}

enum SmsSendStatus {
  pending
  sent
  failed
}

enum SmsRecipientRole {
  student
  parent
}

// Relationships: 
// Student ↔ Parent (Many-to-Many): A student can have multiple parents, and a parent can have multiple students.

// Student → Enrolment → ClassTime (Many-to-Many): A student can enrol in multiple class times, and each class time can have multiple students enrolled.
// - Rosie enrols in Y7 Science CC Sunday 9am by tutor Manhua for Term 1 2024
// - Rosie enrols in Y7 Maths CC Sunday 11am by tutor Manni for Term 1 2024
// - Matthew enrols in Y7 Maths CC Sunday 11am by tutor Manni for Term 1 2024

// ClassTime relationships:
// → SubjectOffering (Many-to-One): Each class belongs to one subject offering
//    - Y7 Science CC Sunday 9am and Y7 Science CC Sunday 11am both belong to the Y7 Science CC SubjectOffering
// → Tutor (Many-to-One): Each class is assigned to one tutor

// SubjectOffering composition:
// → Subject (Many-to-One): Links to the subject type (mathematics, science, etc.)
// → Grade (Many-to-One): Links to the grade level (Y7, Y8, etc.)
// Location (Enum): Cabramatta, Parramatta, or Online
// A subject offering can have multiple class times

// Tutor relationships:
// ↔ Subject (Many-to-Many): Tutors can teach multiple subjects, subjects can be taught by multiple tutors
// → ClassTime (One-to-Many): A tutor can teach multiple classes

// Enrolment → Term (Many-to-One): Each enrolment is for a specific term. Terms can have multiple enrolments

// Attendance & Payment Relationships:
// Student → Attendance ← ClassTime (Tracked per week)
// - Links students to specific classes by week number (1-10)

// Enrolment → Payment (One-to-Many): Each enrolment can have multiple payment records

model Student {
  student_id      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_mobile  String
  first_name      String
  last_name       String
  grade_at_school Int
  school          String
  suburb_of_home  String
  email           String?
  location        Location
  gender          Gender?
  status          StudentStatus?
  notes           String?

  parents     StudentParent[]
  enrolments  Enrolment[]
  attendances Attendance[]
}

model Parent {
  parent_id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_mobile String
  first_name    String
  last_name     String
  email         String?
  notes         String?

  children StudentParent[]
}

model StudentParent {
  student_parent_id String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id        String  @db.Uuid
  parent_id         String  @db.Uuid
  relationship      String?

  student Student @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parent_id], references: [parent_id], onDelete: Cascade)
}

model Tutor {
  details TutorDetails?
  auth_user_id String? @unique @db.Uuid // FK to Supabase auth.users is managed in SQL.
  tutor_id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name String
  last_name  String
  phone      String
  email      String?

  classes           ClassTime[]
  subject_offerings SubjectOffering[]
}

////////////////////
/// ACADEMIC STRUCTURE
////////////////////
model ClassTime {
  class_id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offering_id String  @db.Uuid
  tutor_id    String? @db.Uuid // Allow null for unassigned classes
  day_of_week String
  start_time  String
  end_time    String
  capacity    Int?
  active      Boolean @default(true)

  subject_offering SubjectOffering @relation(fields: [offering_id], references: [subject_id])
  enrolments       Enrolment[]
  attendance       Attendance[]
  tutor            Tutor?          @relation(fields: [tutor_id], references: [tutor_id])
}

// Y7 Science CC - $300
model SubjectOffering {
  subject_id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject_name   String
  grade          Int
  location       Location
  price_per_term Decimal  @db.Decimal(10, 2)

  classTimes    ClassTime[]
  tutor         Tutor?      @relation(fields: [tutorTutor_id], references: [tutor_id])
  tutorTutor_id String?     @db.Uuid

  @@unique([subject_name, grade, location])
}

model Term {
  term_id    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       Int // 1, 2, 3, or 4
  year       Int
  start_date DateTime
  end_date   DateTime

  enrolments  Enrolment[]
  attendances Attendance[]

  @@unique([year, name])
}

model Enrolment {
  enrolment_id   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id     String          @db.Uuid
  class_id       String          @db.Uuid
  term_id        String          @db.Uuid
  enrolment_date DateTime        @default(now())
  status         EnrolmentStatus @default(active)

  student Student   @relation(fields: [student_id], references: [student_id])
  class   ClassTime @relation(fields: [class_id], references: [class_id], onDelete: Cascade)
  term    Term      @relation(fields: [term_id], references: [term_id], onDelete: Cascade)

  payments Payment[]
  smsSends OwingSmsSend[]
  smsSendAttempts SmsSendAttempt[]

  @@unique([student_id, class_id, term_id])
}

model Attendance {
  attendance_id String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id    String           @db.Uuid
  class_id      String           @db.Uuid
  term_id       String           @db.Uuid
  week          Int // e.g. 1, 2, 3, ... 10
  status        AttendanceStatus
  notes         String?

  student Student   @relation(fields: [student_id], references: [student_id])
  class   ClassTime @relation(fields: [class_id], references: [class_id], onDelete: Cascade)
  term    Term      @relation(fields: [term_id], references: [term_id], onDelete: Cascade)

  @@unique([student_id, class_id, term_id, week])
}

////////////////////
/// FINANCE
////////////////////

model Payment {
  payment_id   Int           @id @default(autoincrement())
  enrolment_id String        @db.Uuid
  amount_due   Decimal       @db.Decimal(10, 2)
  amount_paid  Decimal       @db.Decimal(10, 2)
  payment_date DateTime?
  payment_type PaymentType
  status       PaymentStatus
  receipt      String // Store files externally? e.g. (S3, Cloudflare R2, local filesystem) and save the path/URL here
  notes        String?

  enrolment Enrolment @relation(fields: [enrolment_id], references: [enrolment_id])
}

model SmsTemplate {
  sms_template_id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sms_provider         String
  provider_template_id String
  name                 String
  variable_mapping     Json
  reminder_type        SmsReminderType? @unique
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  owingSends OwingSmsSend[]
  sendAttempts SmsSendAttempt[]

  @@unique([sms_provider, provider_template_id])
}

generator prismabox {
  provider = "prisma-client"
  // you can optionally specify the output location. Defaults to ./prismabox
  output   = "./prismaclient-models"
  // // if you want, you can customize the imported variable name that is used for the schemes. Defaults to "Type" which is what the standard typebox package offers
  // typeboxImportVariableName   = "Type"
  // // you also can specify the dependency from which the above import should happen. This is useful if a package re-exports the typebox package and you would like to use that
  // typeboxImportDependencyName = "@sinclair/typebox"
  // // by default the generated schemes do not allow additional properties. You can allow them by setting this to true
  // additionalProperties        = true
  // // optionally enable the data model generation. See the data model section below for more info
  // inputModel                  = true
  // importFileExtension         = ".ts"
}


model TutorDetails {
  tutor_id String @id @db.Uuid
  tutor Tutor @relation(fields: [tutor_id], references: [tutor_id], onDelete: Cascade)
  date_of_birth DateTime? @db.Date
  gender String?
  address String?
  job String @default("tutor")
  start_date DateTime? @db.Date
  end_date DateTime? @db.Date
  emergency_contact_name String?
  emergency_contact_mobile String?
  start_hourly_rate Decimal? @db.Decimal(8, 2)
  tfn String?
  account_name String?
  bsb String?
  account_number String?
  super_name String?
  super_member_number String?
  high_school String?
  university_course String?
  working_with_children String?
  police_check String?
  special_skills String?
  hsc_subjects String[] @default([])
}

// Successful provider submissions, isolated by enrolment and term.
model OwingSmsSend {
  enrolment_id String @db.Uuid
  term_id String @db.Uuid
  template_id String @db.Uuid
  phone_number String
  sent_at DateTime @default(now())

  enrolment Enrolment @relation(fields: [enrolment_id], references: [enrolment_id], onDelete: Cascade)
  template SmsTemplate @relation(fields: [template_id], references: [sms_template_id], onDelete: Cascade)

  @@id([enrolment_id, term_id, template_id, phone_number])
}

model SmsSendAttempt {
  sms_send_attempt_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id String @unique @db.Uuid
  enrolment_id String @db.Uuid
  sms_template_id String @db.Uuid
  reminder_type SmsReminderType
  recipient_phone String
  recipient_role SmsRecipientRole
  recipient_id String @db.Uuid
  status SmsSendStatus @default(pending)
  provider_message_id String?
  error_message String?
  created_at DateTime @default(now())
  sent_at DateTime?

  enrolment Enrolment @relation(fields: [enrolment_id], references: [enrolment_id], onDelete: Restrict)
  template SmsTemplate @relation(fields: [sms_template_id], references: [sms_template_id], onDelete: Restrict)

  @@index([enrolment_id, reminder_type, status])
  @@index([enrolment_id, reminder_type, recipient_phone])
}

model Enquiry {
  enquiry_id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at                 DateTime @default(now()) @db.Timestamptz(6)
  created_by                 String
  first_name                 String
  surname                    String
  parent_phone_number        String
  school                     String
  grade                      Int
  subject_selection          String[]
  suburb_of_home             String
  gender                     String?
  student_phone_number       String?
  email_address              String?
  parent_name                String?
  preferred_campus           String?
  preferred_class_days_times String?
  hear_about_us              String?
  reference                  String?
  additional_comments        String?

  @@index([created_at(sort: Desc)], map: "enquiry_created_at_idx")
}
